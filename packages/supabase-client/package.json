{
  "name": "@sorento/supabase-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#client/mappers": {
      "types": "./src/mappers/index.ts",
      "development": "./src/mappers/index.ts",
      "default": "./dist/mappers/index.js"
    },
    "#client/repositories": {
      "types": "./src/repositories/index.ts",
      "development": "./src/repositories/index.ts",
      "default": "./dist/repositories/index.js"
    },
    "#client/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@sorento/domain": "workspace:*",
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@sorento/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "pg": "^8.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
