# Environment for `pnpm test:functions`. Placeholders only: no real credential belongs here,
# and nothing in this file reaches a running stack: the suites that need one live in
# packages/supabase-client/src/integration-tests.
#
# _shared/env.ts reads these at module load and throws without them, so a test that only wants
# to import a helper still needs the three required variables present.
SUPABASE_URL=http://127.0.0.1:57321
SUPABASE_ANON_KEY=test-anon-key-not-a-credential
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-not-a-credential
SITE_URL=http://localhost:5173
CRON_SECRET=local-dev-cron-secret
RESEND_API_KEY=test-resend-key-not-a-credential
RESEND_FROM_EMAIL=notifications@example.test
SUPPORT_EMAIL=support@example.test
