# Client (apps/web): only VITE_ variables are exposed to the browser.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server (Supabase Edge Functions / scripts / CI only).
# NEVER exposed client-side, never committed with real values.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Transactional email provider (sending Edge Functions: invite-member, notifications).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@example.com

# Base URL used by the Edge Functions to build links (invitations, reset).
SITE_URL=https://app.example.com

# Shared secret protecting the cron-invoked jobs (send-pending-emails, daily-reminders,
# process-dossier-activations): they run as service_role, they must never be publicly
# callable. On the database side the same value lives in Vault (secret "cron_secret");
# locally, seed.sql pins it to "local-dev-cron-secret".
CRON_SECRET=a-long-random-value

# Recipient of activation objections (Edge Function oppose-dossier-activation).
# Unset = the function logs a warning instead of pretending it warned someone.
SUPPORT_EMAIL=support@example.com

# Unlocks the development-only endpoints (dev-signup: account creation without a
# confirmation email). To be set ONLY locally, in supabase/functions/.env (gitignored).
# Absent = door closed: that is the expected state in staging and in production.
APP_ENV=development

# Captcha (hook planned, not enabled in V1).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
